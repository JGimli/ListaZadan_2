<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ListaZadan_2.Tasks"
             xmlns:vm="clr-namespace:ListaZadan_2.ModelView"
             xmlns:models="clr-namespace:ListaZadan_2.Models"
             x:DataType="vm:UserTasksModelView"
             Title="Tasks">
    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0"
               Text="Zadania"
               FontAttributes="Bold"
               FontSize="20"
               Padding="10"/>

        <Grid  Grid.Row="1" 
               RowDefinitions="*,Auto">
            <CollectionView Grid.Row="0"
                            ItemsSource="{Binding UserTasks}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10"
                                       Orientation="Vertical"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserTasks">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding TaskName}"
                                   FontAttributes="Bold"/>
                            
                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Grid.RowSpan="2"
                                   Text="{Binding Description}"
                                   FontAttributes="Bold"/>
                            
                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   HorizontalTextAlignment="Center"
                                   Padding="50,0"
                                   Text="{Binding DueDate}"
                                   FontAttributes="Bold"/>
                            
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Text="Edit"
                                    HeightRequest="40"
                                    FontSize="12"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserTasksModelView}},Path=SetSelectedTaskCommand}"
                                    CommandParameter="{Binding .}"/>
                            
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Text="Del"
                                    HeightRequest="40"
                                    FontSize="12"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserTasksModelView}},Path= DeleteTaskCommand}"
                                    CommandParameter="{Binding Id}"/>
                            
                            <CheckBox Grid.Row="3"
                                      Grid.Column="3"
                                      IsChecked="{Binding IsCompleted}"/>
                            
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <ContentView >
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="No task Asigned"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="You can add new task in panel bellow"/>
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>


            <VerticalStackLayout Grid.Row="1">
                <BoxView Color="{DynamicResource Primary}"
                     HeightRequest="1"/>
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      Padding="10"
                      ColumnSpacing="10"
                      RowSpacing="10"
                      BackgroundColor="#CCAAFF">
                    <VerticalStackLayout Grid.Row="0"
                                     Grid.Column="0">
                        <Label Text="Task Name"/>
                        <Entry Text="{Binding SelectedUserTask.TaskName}"
                           Placeholder="Task Name"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0"
                                         Grid.Column="1">
                        <Label Text="Task Description"/>
                        <Entry Text="{Binding SelectedUserTask.Description}"
                               Placeholder="Task Description"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0"
                                         Grid.Column="2">
                        <Label Text="DataDue"/>
                            <HorizontalStackLayout>
                                <DatePicker Date="{Binding SelectedUserTask.DueDate}"/>
                                <TimePicker Time="{Binding SelectedUserTask.DueDate}"/>
                            </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0"
                     Grid.Column="3">
                        <Label Text="Is Completed"/>
                        <CheckBox IsChecked="{Binding SelectedUserTask.IsCompleted}"/>
                    </VerticalStackLayout>
                    <Button Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Text="Add Task"
                            HorizontalOptions="Center"
                            VerticalOptions="End"
                            CornerRadius="3"
                            Padding="50,0"
                            Command="{Binding SaveTaskCommand}"/>

                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>