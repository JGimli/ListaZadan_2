<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ListaZadan_2.ModelView"
             xmlns:models="clr-namespace:ListaZadan_2.Models"
             x:DataType="vm:UserModelView"
             x:Class="ListaZadan_2.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="20">
            <Label Text="Lista zadań"
                   FontSize="32"
                   HorizontalOptions="Center"
                   Margin="10" />
            <Entry Placeholder="Login"
                   x:Name="LoginEntry"
                   FontSize="20"
                   Margin="10"
                   HorizontalOptions="Center"/>
            <Entry Placeholder="Password"
                   IsPassword="True"
                   x:Name="PasswordEntry"
                   FontSize="20"
                   Margin="10"
                   HorizontalOptions="Center"/>
            <Button Text="Sing in"
                    Clicked="SingInBmt"
                    Margin="30"/>
            <Button Text="Register"
                    Margin="30"
                    Clicked="RegisterPage"/>
            <Button Text="Forgot Password"
                    Margin="30"
                    Clicked="ForgotPage"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
